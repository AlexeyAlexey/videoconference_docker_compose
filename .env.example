# Runtime configuration for docker compose (read by docker-compose.yml).
# Copy this to .env and adjust as needed:   cp .env.example .env


# frontend
FRONTEND_APP_VITE_SCHEMA=https
FRONTEND_APP_VITE_HOST=localhost
FRONTEND_APP_VITE_PORT=8443
FRONTEND_APP_VITE_MANAGER_WEBSOCKET_SERVER_PROTOCOL=wss
FRONTEND_APP_VITE_MANAGER_HTTP_SERVER_PROTOCOL=https
FRONTEND_APP_VITE_MANAGER_SERVER_HOST=localhost
FRONTEND_APP_VITE_MANAGER_SERVER_PORT=8443
FRONTEND_APP_VITE_MANAGER_HTTP_SERVER_PORT=8443

# video_conference
VIDEO_CONFERENCE_APP_MIX_ENV=prod
VIDEO_CONFERENCE_APP_PHX_HOST=localhost
VIDEO_CONFERENCE_APP_PORT=443
VIDEO_CONFERENCE_APP_HTTP3_SERVER_HOST=localhost
VIDEO_CONFERENCE_APP_HTTP3_SERVER_PORT=4433
# JWT signing secret for video_conference (HS256 session tokens).
VIDEO_CONFERENCE_APP_JWT_SECRET=local-docker-jwt-secret-0123456789
# Phoenix secret key base (signs cookies/sessions). Generate with: mix phx.gen.secret
VIDEO_CONFERENCE_APP_SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
# HTTP3_SERVER_CERT_HASH is set automatically by scripts/gen_media_cert.sh.
# The other two are local-dev defaults — change them for anything non-local.

# SHA-256 of certs/server.crt (DER). Must match the <=12-day media cert.
# (scripts/gen_media_cert.sh writes this for you.)
VIDEO_CONFERENCE_APP_HTTP3_SERVER_CERT_HASH=

# http3_server
HTTP3_SERVER_APP_MIX_ENV=prod
HTTP3_SERVER_APP_HOST=0.0.0.0
HTTP3_SERVER_APP_PORT=4433

# Secret used to encrypt stored stream server private keys (openssl rand -hex 32)
VIDEO_CONFERENCE_APP_SECRET_KEY_TO_ENCRYPT_PRIVATE_KEY=generate-with-mix-phx-gen-secret